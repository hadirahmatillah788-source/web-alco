datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  KARYAWAN
}

enum StatusPengumuman {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TipeSukuBunga {
  KONVENSIONAL
  SYARIAH
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  password     String
  role         Role          @default(KARYAWAN)
  department   String?
  isActive     Boolean       @default(true) // Status aktif akun viewer/user
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  pengumuman   Pengumuman[]

  @@map("users")
}

model Pengumuman {
  id               String           @id @default(cuid())
  judul            String
  nomorRapat       String?
  tanggalRapat     DateTime
  lokasi           String?
  kategori         String           // e.g., "Manajemen", "ALCO / Treasury", "HR / SDM", "Operasional", "Kredit"
  status           StatusPengumuman @default(DRAFT)
  isAktif          Boolean          @default(true) // true = Aktif / Berlaku, false = Non-Aktif / Telah Diperbarui
  keteranganStatus String?          // Catatan pembaruan, misal "Diperbarui oleh SK No. 014/ALCO/X/2026"
  ringkasan        String?          @db.Text
  isiKeputusan     String           @db.Text // Mendukung Paragraf & Tabel (Rich Content / Markdown)
  isDeleted        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  authorId         String
  author           User             @relation(fields: [authorId], references: [id])
  lampiran         Lampiran[]

  @@index([tanggalRapat])
  @@index([kategori])
  @@index([status])
  @@index([isAktif])
  @@map("pengumuman")
}

model KategoriHasilRapat {
  id        String   @id @default(cuid())
  nama      String   @unique
  deskripsi String?
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kategori_hasil_rapat")
}

model Lampiran {
  id           String      @id @default(cuid())
  namaFile     String
  fileUrl      String      // Link Google Drive
  driveFileId  String?     // ID file Google Drive untuk penampil iframe view-only
  keterangan   String?
  createdAt    DateTime    @default(now())

  pengumumanId String
  pengumuman   Pengumuman  @relation(fields: [pengumumanId], references: [id], onDelete: Cascade)

  @@map("lampiran")
}

model JenisBunga {
  id          String          @id @default(cuid())
  kode        TipeSukuBunga   @unique // KONVENSIONAL atau SYARIAH
  nama        String          // "Konvensional" / "Syariah"
  deskripsi   String?
  urutan      Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  kategori    KategoriBunga[]

  @@map("jenis_bunga")
}

model KategoriBunga {
  id          String        @id @default(cuid())
  jenisId     String
  jenis       JenisBunga    @relation(fields: [jenisId], references: [id], onDelete: Cascade)
  nama        String        // e.g. "Tabungan", "Kredit Produktif", "Deposito", "Giro"
  slug        String
  deskripsi   String?
  urutan      Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  produk      ProdukBunga[]

  @@unique([jenisId, slug])
  @@map("kategori_bunga")
}

model ProdukBunga {
  id             String         @id @default(cuid())
  kategoriId     String
  kategori       KategoriBunga  @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  nama           String         // e.g. "Tabungan Simpeda", "Deposito 1 Bulan", "Kredit Modal Kerja"
  rate           String         // e.g. "2.5%", "8.50% p.a.", "Nisbah 45 : 55 (Eq. 5.10%)"
  tenorTiering   String?        // e.g. "1 - 3 Tahun", "Saldo >= Rp 500 Juta"
  saldoMinimal   String?        // e.g. "Setoran awal Rp 100.000"
  keterangan     String?        // Catatan ALCO atau fasilitas
  isActive       Boolean        @default(true) // Soft delete / status aktif
  urutan         Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([kategoriId])
  @@index([isActive])
  @@map("produk_bunga")
}

